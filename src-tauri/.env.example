# =============================================================================
# Live MR Manager — local environment template (src-tauri/.env)
# Copy to `.env` and fill values. Never commit real secrets.
# OS / CI environment variables always win (dotenv does not override them).
# =============================================================================

# --- Discord (optional) -------------------------------------------------------
# Release announce script / CI only. Must be a Discord Incoming Webhook URL.
# Prefer GitHub Actions secret `DISCORD_WEBHOOK_URL` in production.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# Public invite link override (optional; frontend may keep its default).
# DISCORD_INVITE_URL=https://discord.gg/<invite-code>

# --- Songbook / external API (optional, local override) -----------------------
# Allowlisted hosts only: livemrsongbook.com, workers.dev staging, localhost.
# SONGBOOK_BASE_URL=http://localhost:5173

# --- Runtime toggles ----------------------------------------------------------
# Set to 0/false to force CPU-only ONNX providers.
# LIVE_MR_ENABLE_GPU=1
